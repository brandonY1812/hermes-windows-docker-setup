# =============================================================================
# .dockerignore — files excluded from Docker build context
# =============================================================================
# These files/directories are NOT sent to the Docker daemon during build,
# which keeps the build context small and prevents leaking sensitive data.

# Binary downloads are not needed at build time.
camofox-browser/

# Build artifacts are rebuilt inside the image.
dist/

# Git history and host bootstrap scripts are not used in Linux containers.
.git/
*.bat
setup-hermes.sh
